rules_version = '2';

// The site's server reads and writes Firestore with its service account (FIREBASE_SERVICE_ACCOUNT),
// which these rules do not apply to. Browsers never talk to Firestore directly, so nothing is open
// to them: the store holds fans' emails, sign-in sessions and the keys saved in Admin → Environment.
//
// Publish after FIREBASE_SERVICE_ACCOUNT is set in Vercel (Firebase console → Firestore → Rules, or
// `firebase deploy --only firestore:rules`). Without the service account the server falls back to
// the browser SDK, which these rules (correctly) block.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
