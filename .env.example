# ADT10 Fans: environment variables. Copy to .env for local development.
# Only ADMIN_EMAILS is needed to try the site locally; everything else switches on optional features.

# ---- Required ----
# Comma-separated emails that are super admins (full Admin Console access, can add other admins).
# The owner account solarastra.in@gmail.com is always a super admin.
ADMIN_EMAILS=""
# Public URL of the site (canonical links, sitemap.xml, robots.txt, invite links), e.g. https://fans.example.com
APP_URL=""

# ---- Storage: pick one ----
# A) One long-running server with a persistent disk: a folder for the JSON store.
DATA_DIR=""
# B) Serverless (Vercel) or several instances: a Google Cloud Storage bucket. Every instance reads
#    and writes the same object with conditional writes, so no change is ever lost.
STORE_BUCKET=""
STORE_OBJECT="t10_store.json"
# Service-account JSON (raw or base64) with "Storage Object Admin" on the bucket.
# If empty, FIREBASE_SERVICE_ACCOUNT is used.
STORE_SERVICE_ACCOUNT=""

# ---- Scheduled jobs ----
# Shared secret for /api/cron/run (lock reminders, live scores, feed pulls). Vercel Cron sends it
# automatically when set; the GitHub Actions workflow sends it from the repository secret of the same name.
CRON_SECRET=""
# Minutes between feed pulls (YouTube, X, Curator, news). Minimum 5.
FEED_SYNC_MINUTES="30"
# Default "Dream XI locks in N minutes" reminder (also editable in Admin > Settings).
LOCK_REMINDER_MINUTES="30"
# Set to "off" to stop the built-in 60-second job timer on long-running servers (use cron instead).
SCHEDULED_JOBS=""

# ---- Sign-in ----
# Google sign-in uses the Firebase project in firebase-applet-config.json. Override if needed:
FIREBASE_PROJECT_ID=""
# Email one-time codes. Required in production for email sign-in (otherwise only Google works).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
# Optional extra secret mixed into stored OTP hashes
OTP_PEPPER=""

# ---- Live scores (optional) ----
# CricketData.org API key. Turns on live scores for fixtures linked to a CricketData match id
# (Admin > Matches > Find), automatic results, scorecards and Dream XI scoring.
CRICKET_API_KEY=""
# CricketData series id for the season (used by Admin > Squad tools when reading squads).
CRICKETDATA_SERIES_ID=""
# Cricbuzz series number used by the squad tools' Cricbuzz option.
CRICBUZZ_SERIES_ID="13307"

# ---- Daily games ----
# Secret that decides each day's mystery player and Super Over outcomes. If empty, a random
# secret is generated once and kept in the store (fine for most deployments).
GAME_SECRET=""

# ---- Push notifications (optional) ----
# Web push VAPID key from Firebase console > Project settings > Cloud Messaging > Web Push certificates
FCM_VAPID_KEY=""
# Service-account JSON (raw or base64) with Firebase Cloud Messaging permission, used to send pushes
FIREBASE_SERVICE_ACCOUNT=""

# ---- AI assistant (optional) ----
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# ---- Social ----
# Curator.io feed for Instagram/X/TikTok/Facebook posts (can also be set in Admin Console > Settings)
CURATOR_FEED_ID=""
CURATOR_API_KEY=""
