# Environment Variables for ADT10 Fans

# Required in AI Studio / Deployment (or set in Admin Console)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Core Settings
ADMIN_EMAILS=
APP_URL=
DATA_DIR=
SCHEDULED_JOBS=

# Storage & Firebase
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=
STORE_BUCKET=

# Live Cricket & Feeds
CRICKET_API_KEY=
CRICKETDATA_SERIES_ID=
CRICBUZZ_SERIES_ID=
CURATOR_FEED_ID=
CURATOR_API_KEY=

# Notifications & Auth
FCM_VAPID_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Fan wall photos: Firebase Storage bucket (defaults to the project's bucket from firebase-applet-config.json)
# FANWALL_BUCKET=
# Storage: file | firestore | gcs | firestore-sdk (default: firestore when a service account is set or on Vercel, else file)
# STORE_BACKEND=
# Mail server with a self-signed certificate (turns off certificate checks for SMTP)
# SMTP_INSECURE_TLS=1
