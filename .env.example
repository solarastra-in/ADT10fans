# ---- Required ----
# Comma-separated emails that get Admin Console access (they sign in with Google or email code).
ADMIN_EMAILS=""
# Public URL of the site, used for sitemap.xml/robots.txt (e.g. https://fans.example.com)
APP_URL=""

# ---- Storage ----
# Folder for the JSON data store. In containers (Cloud Run etc.) mount a persistent volume
# here, e.g. a Cloud Storage FUSE volume at /mnt/data, or data is lost on every restart.
DATA_DIR=""

# ---- Sign-in ----
# Google sign-in uses the Firebase project in firebase-applet-config.json. Override if needed:
FIREBASE_PROJECT_ID=""
# Email one-time codes. Required in production for email sign-in (otherwise only Google works).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
# Optional extra secret mixed into stored OTP hashes
OTP_PEPPER=""

# ---- Push notifications (optional) ----
# Web push VAPID key from Firebase console > Project settings > Cloud Messaging > Web Push certificates
FCM_VAPID_KEY=""
# Service-account JSON (raw or base64) with Firebase Cloud Messaging permission, used to send pushes
FIREBASE_SERVICE_ACCOUNT=""

# ---- AI assistant (optional) ----
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# ---- Social ----
# Curator.io feed for Instagram/X/TikTok/Facebook embeds (can also be set in Admin Console > Settings)
CURATOR_FEED_ID=""
CURATOR_API_KEY=""
# Minutes between automatic YouTube/news refreshes (0 disables)
FEED_SYNC_MINUTES="30"
