# ADT10 Fans: environment variables.
#
# On Vercel only ONE is needed: FIREBASE_SERVICE_ACCOUNT. Everything else (live-score key, email,
# push key, AI key, admin emails, site address, timings) is set in Admin → Environment after you sign
# in; values saved there apply on every server. Any of them can still be given here instead, but a
# value saved in the console wins.

# ---- Required on Vercel ----
# Firebase console → Project settings → Service accounts → Generate new private key. Paste the whole
# JSON (or base64 of it). The site stores its data in your Firestore database and sends push with it.
FIREBASE_SERVICE_ACCOUNT=""

# ---- Local development ----
# Your email gets the admin console locally (the owner solarastra.in@gmail.com always has it).
ADMIN_EMAILS=""
# Locally the store is a file in ./data unless STORE_BACKEND=firestore.
DATA_DIR=""

# ---- Optional storage alternatives ----
# STORE_BACKEND="file" | "firestore"     force a store (default: Firestore when deployed with a service account)
# STORE_BUCKET=""                         use a Cloud Storage bucket instead of Firestore
# FIRESTORE_DATABASE_ID=""                defaults to firestoreDatabaseId in firebase-applet-config.json
# STORE_COLLECTION="adt10_store"

# ---- Scheduled jobs ----
# Jobs run by themselves after visits. "off" disables them; "traffic" disables the per-minute timer
# on long-running servers but keeps the visit-driven runs.
SCHEDULED_JOBS=""

# ---- Also settable in Admin → Environment ----
# APP_URL, CRICKET_API_KEY, CRICKETDATA_SERIES_ID, CRICBUZZ_SERIES_ID, SMTP_HOST, SMTP_PORT, SMTP_USER,
# SMTP_PASS, SMTP_FROM, OTP_PEPPER, FCM_VAPID_KEY, GEMINI_API_KEY, GEMINI_MODEL, CURATOR_FEED_ID,
# CURATOR_API_KEY, FEED_SYNC_MINUTES, LOCK_REMINDER_MINUTES, CRON_SECRET, FIREBASE_PROJECT_ID
