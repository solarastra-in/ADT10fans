{
  "name": "adt10-fans",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build && node -e \"require('fs').renameSync('dist/index.html','dist/_template.html')\"",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist-server/server.mjs",
    "start": "NODE_ENV=production node dist-server/server.mjs",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "bash tests/run-e2e.sh api",
    "test:storage": "bash tests/run-e2e.sh storage",
    "test:browser": "bash tests/run-e2e.sh browser",
    "test:prod": "bash tests/run-e2e.sh prod",
    "test:all": "bash tests/run-e2e.sh all",
    "clean": "rm -rf dist dist-server"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.5",
    "@vercel/functions": "^2.2.13",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "jose": "^6.2.12",
    "lucide-react": "^0.546.0",
    "nodemailer": "^10.0.10",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "playwright-core": "^1.50.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
